# Copy to .env and fill in. NEVER commit .env.
# Values come from your Postgres host (see docs/HOSTING_GUIDE.md).

PGHOST=aws-0-eu-central-1.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.your_project_ref
PGPASSWORD=your_database_password
PGSCHEMA=public
PGSSLMODE=require

# Batch size for the bulk load. 5000 is a good default for a free-tier host.
LOAD_CHUNK_SIZE=5000
