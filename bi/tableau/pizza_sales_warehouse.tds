<?xml version='1.0' encoding='utf-8' ?>
<!--
  Tableau datasource file for the Pizza Sales Analytics warehouse.
  HOW TO USE
    1. Open the two placeholders below and replace them:
         PGHOST_PLACEHOLDER  -> aws-0-<region>.pooler.supabase.com
         PGUSER_PLACEHOLDER  -> postgres.<your_project_ref>
    2. Double-click this file (or Tableau Desktop > File > Open).
    3. Tableau prompts for the password. Tick "Require SSL".
    4. Extract the data (Data > <datasource> > Extract) before publishing
       to Tableau Public - Public cannot hold live database credentials.
  Requires the PostgreSQL JDBC driver from tableau.com/support/drivers.
-->
<datasource formatted-name='pizza_sales_warehouse' inline='true' source-platform='win' version='18.1'>
  <connection class='federated'>
    <named-connections>
      <named-connection caption='pizza-sales-analytics' name='postgres.pizza'>
        <connection class='postgres'
                    dbname='postgres'
                    server='PGHOST_PLACEHOLDER'
                    port='5432'
                    username='PGUSER_PLACEHOLDER'
                    sslmode='require'
                    schema='public'
                    authentication='username-password'
                    one-time-sql=''/>
      </named-connection>
    </named-connections>
    <relation connection='postgres.pizza' name='vw_fact_enriched' table='[public].[vw_fact_enriched]' type='table' />
    <metadata-records />
  </connection>
  <aliases enabled='yes' />
  <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
</datasource>
